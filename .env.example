# Copy to .env and fill in values. Never commit .env.

# --- mysql ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_USER=commute_app
MYSQL_PASSWORD=change_me

# --- mongo ---
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_APP_USER=analytics_user
MONGO_APP_PASSWORD=change_me
MONGO_URI=mongodb://analytics_user:change_me@mongo-db:27017/analytics_db?authSource=analytics_db

# --- auth ---
JWT_SECRET=change_me_long_random_string
